package ngsoc {
    #[tag(log_desc: "NGSOC告警信息", log_type: "ngsoc_alert_info", log_category:"400", data_business_type: "6")]
    rule ngsoc_alert_info {
        (
            _:pri<<,>>
        ),
        (
            time:update_time,
            _,
            symbol(qax.ngsoc:)
        ),
        (
            kvarr(
                time@latestTimestamp,
                chars@name,
                chars@severity,
                chars@compromiseState,
                chars@attackResult,
                array/chars@srcIp,
                array/chars@dstIp,
                chars@times,
                chars@attCk<[,]>,
                chars@ioc<[,]>,
                chars@iocType<[,]>,
                chars@uri<[,]>,
                chars@virusName,
                chars@occurDays,
                chars@disposeTime,
                chars@disposeState,
                chars@creator,
                chars@proxyIp,
                chars@maliciousFamily<[,]>,
                chars@malwareName,
                chars@tags,
                chars@source,
                chars@seq,
                chars@ticketState,
                chars@killchain,
                array/chars@attackerContent,
                array/chars@victimContent,
                chars@ipGeo<[,]>,
                chars@relevantNetworkSegmentId<[,]>,
                chars@relevantAssetsName<[,]>,
                chars@relevantAssetsGroup<[,]>,
                chars@attentionValue,
                array/chars@ruleId,
                chars@ruleName<[,]>,
                chars@hashType,
                chars@scheduleTaskName,
                chars@relevantRuleName,
                chars@processName,
                chars@clientType,
                chars@dstUser,
                chars@dipGeo,
                array/chars@dport,
                chars@authType,
                chars@eventTypeCode,
                chars@eventType,
                time@timestamp,
                chars@relevantLogsType<[,]>,
                chars@devIp<[,]>,
                chars@commDirection<[,]>,
                chars@ruleCategoryName,
                chars@fileMd5,
                chars@fileHash,
                chars@fileName,
                chars@protocol<[,]>,
                chars@appName,
                chars@userName,
                chars@domain<[,]>,
                chars@sipGeo,
                array/chars@sport,
                chars@srcUser,
                chars@confidence,
                chars@hostName,
                chars@resourceType,
                chars@resourceName,
                chars@domainId<[,]>,
                chars,
            ){\|(\S=)}
        ),
        (*_)
    }
}
