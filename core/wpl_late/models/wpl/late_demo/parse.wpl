package /late_demo {
    // ── 兜底规则：故意声明在最前面 ────────────────────────────────────
    // 它匹配任何一行。若不加 #[late]，装配顺序就是声明顺序，
    // 它会被第一个尝试，于是吃掉所有事件，下面三条具体规则永远拿不到数据。
    // 加了 #[late] 后，装配期会把它固定挪到普通规则之后。
    #[late]
    rule fallback_other {
        (chars:raw\0)
    }

    // ── 三条具体规则：各自只认一种结构化格式 ──────────────────────────
    // `)\,` 是组级分隔符：整组字段按逗号切分。
    rule metrics_csv {
        (digit:a,digit:b,digit:c)\,
    }

    rule kv_pairs {
        (kv)
    }

    rule json_obj {
        (json(digit@a, chars@b))
    }
}
